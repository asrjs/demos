{
  "name": "@asrjs/firered-vad-web",
  "version": "0.1.0",
  "description": "FireRedVAD for Node.js and browser with WASM-first ONNX Runtime",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/platform/node/index.d.ts",
      "import": "./dist/platform/node/index.js",
      "default": "./dist/platform/node/index.js"
    },
    "./browser": {
      "types": "./dist/platform/browser/index.d.ts",
      "import": "./dist/platform/browser/index.js",
      "default": "./dist/platform/browser/index.js"
    },
    "./worker": {
      "types": "./dist/workers/browser-worker.d.ts",
      "import": "./dist/workers/browser-worker.js",
      "default": "./dist/workers/browser-worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node ./scripts-copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,mjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,mjs}\" \"docs/**/*.md\"",
    "parity:node": "node ./tools/parity/node-parity.mjs",
    "profile:rtfx": "npm run build && node ./tools/profile/node-rtfx.mjs",
    "profile:browser": "npm run build && vite --open /examples/browser-rtfx-profiler.html",
    "upstream:check": "node ./tools/upstream/check-upstream.mjs"
  },
  "keywords": [
    "fireredvad",
    "vad",
    "aed",
    "onnx",
    "wasm",
    "browser",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asrjs/firered-vad-web.git"
  },
  "bugs": {
    "url": "https://github.com/asrjs/firered-vad-web/issues"
  },
  "homepage": "https://github.com/asrjs/firered-vad-web#readme",
  "license": "MIT",
  "dependencies": {
    "onnxruntime-web": "1.25.0-dev.20260228-6e72d31970"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "24.1.0",
    "eslint": "^9.22.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "4.0.18"
  }
}
