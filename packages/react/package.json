{
  "name": "@asrjs/speech-recognition-react",
  "version": "0.1.0",
  "description": "React bindings for @asrjs/speech-recognition: in-browser speech recognition state in your components.",
  "keywords": [
    "asr",
    "speech-recognition",
    "speech-to-text",
    "transcription",
    "webgpu",
    "react",
    "hooks"
  ],
  "homepage": "https://github.com/asrjs/demos/tree/framework-examples/packages/react#readme",
  "bugs": {
    "url": "https://github.com/asrjs/speech-recognition/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asrjs/demos.git",
    "directory": "packages/react"
  },
  "license": "LICENSE-PENDING",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@asrjs/speech-recognition": "^0.3.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
