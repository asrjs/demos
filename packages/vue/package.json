    "speech-recognition",
    "speech-to-text",
    "transcription",
    "webgpu",
    "vue",
    "composable"
  ],
  "homepage": "https://github.com/asrjs/demos/tree/framework-examples/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/asrjs/speech-recognition/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asrjs/demos.git",
    "directory": "packages/vue"
  },
  "license": "LICENSE-PENDING",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
